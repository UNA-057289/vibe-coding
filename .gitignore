# ============================================================
# .gitignore —— Git 的"黑名单"
# 写在这里的文件/文件夹，Git 绝不提交、绝不上传到 GitHub
# 一行一个规则，# 开头的是注释
# ============================================================

# ---------- 1. 环境变量文件（最容易漏、后果最严重）----------
# .env 里以后会存数据库地址、密码，第 23 天才会用到，今天先拦住
.env
.env.local
.env.*.local

# ---------- 2. 密钥 / 证书 / 凭据 ----------
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json

# ---------- 3. 依赖目录（体积巨大，随时能重装）----------
node_modules/
.pnpm-store/

# ---------- 4. 本地数据库文件 ----------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdb

# ---------- 5. 日志与缓存 ----------
*.log
logs/
.cache/
npm-debug.log*
yarn-error.log*

# ---------- 6. 编辑器 / 系统产生的垃圾文件 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ---------- 7. 构建产物 ----------
dist/
build/
